        {
          "value": "text-left",
          "label": "t:blocks.heading.settings.heading_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:blocks.heading.settings.heading_alignment.options__2.label"
        },
        {
          "value": "text-right",
          "label": "t:blocks.heading.settings.heading_alignment.options__3.label"
        },
        {
          "value": "text-inherit",
          "label": "Inherit"
        }
      ],
      "default": "text-inherit",
      "label": "t:blocks.heading.settings.heading_alignment.label"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "vt-hero-heading",
          "label": "t:blocks.heading.settings.heading_size.options__1.label"
        },
        {
          "value": "vt-heading-h1",
          "label": "t:blocks.heading.settings.heading_size.options__2.label"
        },
        {
          "value": "vt-heading-h2",
          "label": "t:blocks.heading.settings.heading_size.options__3.label"
        },
        {
          "value": "vt-heading-h3",
          "label": "t:blocks.heading.settings.heading_size.options__4.label"
        },
        {
          "value": "vt-heading-h4",
          "label": "t:blocks.heading.settings.heading_size.options__5.label"
        },
        {
          "value": "vt-heading-h5",
          "label": "t:blocks.heading.settings.heading_size.options__6.label"
        },
        {
          "value": "vt-heading-h6",
          "label": "t:blocks.heading.settings.heading_size.options__7.label"
