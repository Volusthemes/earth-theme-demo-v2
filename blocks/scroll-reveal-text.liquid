      "id": "heading",
      "default": "Add a statement that lights up as customers scroll",
      "label": "t:blocks.heading.settings.heading.label",
      "info": "Shown as plain text: bold, italic and links are removed."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_alignment",
