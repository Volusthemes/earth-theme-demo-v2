      "visible_if": "{{ block.settings.animation_type == 'blur' }}"
    }
  ],
  "presets": [
    {
      "name": "Scroll reveal text",
      "category": "t:general.categories.basic",
      "settings": {
        "heading": "Add a statement that lights up as customers scroll",
        "heading_size": "vt-heading-h2",
        "heading_alignment": "text-inherit",
        "heading_tag": "h2",
        "uppercase": false,
