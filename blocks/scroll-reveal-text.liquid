{% doc %}
  Renders text that lights up word by word as it is scrolled through the screen.

  Each word is a span with its index (--vt-word). The script sets one property on the
  block, --vt-progress (0 to 1), and the stylesheet turns it into each word's opacity.
  The words stay real text in a real heading tag, so screen readers and search engines
  read the sentence as written. Without the script, or with reduced motion, all words
  show in full.

  @example
  {% content_for 'block', type: 'scroll-reveal-text', id: 'scroll-reveal-text' %}
{% enddoc %}

{%- if block.settings.heading != blank -%}
  {%- liquid
    assign words = block.settings.heading | strip_html | split: ' '
    assign heading_tag = block.settings.heading_tag
    assign animation_type = block.settings.animation_type

    assign vt_anim_classes = ''
    unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
      assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type
      if animation_type == 'slide' or animation_type == 'reveal'
        assign vt_anim_classes = vt_anim_classes | append: ' vt-animate--dir-' | append: block.settings.animation_direction
      endif
    endunless

    assign heading_class = 'vt-heading ' | append: block.settings.heading_size
    if block.settings.uppercase
      assign heading_class = heading_class | append: ' uppercase!'
    endif
    if vt_anim_classes != blank
      assign heading_class = heading_class | append: ' ' | append: vt_anim_classes
    endif

    assign vt_style = ''
    unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
      assign vt_style = vt_style | append: '--vt-duration: ' | append: block.settings.animation_duration | append: 's;'
      assign vt_style = vt_style | append: ' --vt-delay: ' | append: block.settings.animation_delay | append: 's;'

      if animation_type == 'slide' or animation_type == 'reveal' or animation_type == 'blur'
        case block.settings.animation_easing
          when 'linear'
            assign vt_easing_value = 'linear'
          when 'ease-in-sine'
            assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)'
          when 'ease-in-out-sine'
            assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)'
          when 'ease-in-cubic'
            assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)'
          when 'ease-out-cubic'
            assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)'
          when 'ease-in-out-cubic'
            assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)'
          else
            assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
        endcase
        assign vt_style = vt_style | append: ' --vt-easing: ' | append: vt_easing_value | append: ';'
      endif

      if animation_type == 'blur'
        assign vt_style = vt_style | append: ' --vt-blur: ' | append: block.settings.animation_blur_intensity | append: 'px;'
      endif
    endunless

    assign start_opacity = block.settings.start_opacity | divided_by: 100.0

    assign vt_wrapper_class = 'vt-heading-wrapper ' | append: block.settings.heading_alignment | append: ' vt-heading-wrapper--width-' | append: block.settings.heading_width
  -%}

  <vt-scroll-reveal
    class="vt-scroll-reveal {{ vt_wrapper_class }} flex"
    style="
      --vt-start-opacity: {{ start_opacity }};
      {%- if request.visual_preview_mode %} --vt-progress: 0.6;{% endif -%}
      {%- if block.settings.heading_width == 'custom' %} --vt-heading-width: {{ block.settings.width_custom }}%;{% endif -%}
      {%- if block.settings.enable_max_width %} --vt-heading-max-width: {% render 'fluid-clamp', min_px: block.settings.heading_max_width, max_px: block.settings.heading_max_width %};{% endif -%}
    "
    {% if request.visual_preview_mode %}
      data-preview
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <{{ heading_tag }}
      class="{{ heading_class }}"
      {% if vt_style != blank %}
        style="{{ vt_style | strip }}"
      {% endif %}
    >
      <span class="vt-scroll-reveal__words" style="--vt-words: {{ words.size }};">
        {%- for word in words -%}
          <span class="vt-scroll-reveal__word" style="--vt-word: {{ forloop.index0 }};">{{ word }}</span>
          {%- unless forloop.last -%}{{ ' ' }}{%- endunless -%}
        {%- endfor -%}
      </span>
    </{{ heading_tag }}>
  </vt-scroll-reveal>

  {%- unless request.visual_preview_mode -%}
    <script src="{{ 'theme-scroll-reveal-text.js' | asset_url }}" type="module"></script>
  {%- endunless -%}
{%- endif -%}

{% stylesheet %}
  .vt-scroll-reveal__word {
    overflow-wrap: anywhere;
  }

  /*
    Word i stays at the start opacity until the reveal reaches it, then turns fully
    visible while the reveal moves over the next --vt-trail words, so a few words are
    always fading in together. Only once the script is running (:defined): until
    then, and without it, every word shows in full.
  */
  @media (prefers-reduced-motion: no-preference) {
    :is(vt-scroll-reveal:defined, vt-scroll-reveal[data-preview]) .vt-scroll-reveal__word {
      --vt-trail: 4;
      opacity: calc(
        var(--vt-start-opacity) + (1 - var(--vt-start-opacity)) *
          clamp(
            0,
            (var(--vt-progress, 0) * (var(--vt-words) + var(--vt-trail)) - var(--vt-word)) / var(--vt-trail),
            1
          )
      );
    }
  }
{% endstylesheet %}

