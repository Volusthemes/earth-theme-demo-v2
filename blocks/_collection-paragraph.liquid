      "content": "t:blocks.paragraph.settings.header_animation.content"
    },
    {
      "type": "select",
      "id": "animation_type",
      "info": "Turned off in the first section of a page, so it loads faster.",
      "options": [
        { "value": "none",  "label": "t:blocks.paragraph.settings.animation_type.options__1.label" },
        { "value": "fade",  "label": "t:blocks.paragraph.settings.animation_type.options__2.label" },
        { "value": "slide", "label": "t:blocks.paragraph.settings.animation_type.options__3.label" },
        { "value": "reveal", "label": "t:blocks.paragraph.settings.animation_type.options__4.label" },
