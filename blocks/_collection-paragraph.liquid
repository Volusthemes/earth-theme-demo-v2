          "value": "line-clamp-1",
          "label": "1 line"
        },
        {
          "value": "line-clamp-2",
          "label": "2 lines"
        },
        {
          "value": "line-clamp-3",
          "label": "3 lines"
        },
        {
          "value": "line-clamp-4",
          "label": "4 lines"
        },
        {
          "value": "line-clamp-5",
          "label": "5 lines"
        },
        {
          "value": "line-clamp-6",
          "label": "6 lines"
        },
        {
          "value": "line-clamp-none",
          "label": "None"
        }
      ],
        "default": "line-clamp-1"
    },
    {
      "type": "select",
      "id": "paragraph_alignment",
      "options": [
        { 
          "value": "text-left",    
          "label": "t:blocks.paragraph.settings.paragraph_alignment.options__1.label" 
        },
        { 
          "value": "text-center",  
          "label": "t:blocks.paragraph.settings.paragraph_alignment.options__2.label" 
        },
        { 
          "value": "text-right",   
          "label": "t:blocks.paragraph.settings.paragraph_alignment.options__3.label" 
        },
        { 
          "value": "text-inherit", 
          "label": "Inherit" 
        }
      ],
      "default": "text-inherit",
      "label": "t:blocks.paragraph.settings.paragraph_alignment.label"
    },      
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "paragraph_size",
      "options": [
        { "value": "vt-paragraph-extra-small", "label": "t:blocks.paragraph.settings.paragraph_size.options__1.label" },
        { "value": "vt-paragraph-small",       "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label" },
        { "value": "vt-paragraph-medium",      "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label" },
        { "value": "vt-paragraph-large",       "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label" }
      ],
      "default": "vt-paragraph-medium",
      "label": "t:blocks.paragraph.settings.paragraph_size.label"
    },
    {
      "type": "select",
      "id": "paragraph_width",
      "label": "Width",
      "options": [
