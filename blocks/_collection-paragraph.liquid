      ],
      "default": "none",
      "label": "t:blocks.paragraph.settings.animation_type.label"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "options": [
        { "value": "from-left",   "label": "t:blocks.paragraph.settings.animation_direction.options__1.label" },
        { "value": "from-right",  "label": "t:blocks.paragraph.settings.animation_direction.options__2.label" },
        { "value": "from-top",    "label": "t:blocks.paragraph.settings.animation_direction.options__3.label" },
        { "value": "from-bottom", "label": "t:blocks.paragraph.settings.animation_direction.options__4.label" }
      ],
      "default": "from-bottom",
      "label": "t:blocks.paragraph.settings.animation_direction.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' }}"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.1, "max": 3, "step": 0.1, "unit": "s",
      "default": 1.2,
      "label": "t:blocks.paragraph.settings.animation_duration.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0, "max": 2, "step": 0.1, "unit": "s",
      "default": 0.2,
      "label": "t:blocks.paragraph.settings.animation_delay.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "options": [
        { "value": "linear",            "label": "t:blocks.paragraph.settings.animation_easing.options__1.label" },
        { "value": "ease-out-sine",     "label": "t:blocks.paragraph.settings.animation_easing.options__2.label" },
        { "value": "ease-in-sine",      "label": "t:blocks.paragraph.settings.animation_easing.options__3.label" },
        { "value": "ease-in-out-sine",  "label": "t:blocks.paragraph.settings.animation_easing.options__4.label" },
