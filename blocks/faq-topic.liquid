{% doc %}
  "Topic with anchor": a heading with the topic's content under it (an
  Accordion of questions, or any other blocks), for an FAQ, a policy or a
  size guide page.

  The heading is also the topic's anchor: the page can link to it
  (/pages/faq#shipping-delivery), and a Topic menu (blocks/faq-topic-menu.liquid) in the same section
  lists it, with the icon picked here, and highlights it while it's read.

  @example
  {% content_for 'block', type: 'faq-topic', id: 'faq-topic' %}
{% enddoc %}

{%- liquid
  assign title = block.settings.title
  # A readable anchor from the title, so links to a topic can be shared
  assign anchor = title | handleize
  if anchor == blank
    assign anchor = 'faq-topic-' | append: block.id
  endif

  assign animation_classes = ''
  unless block.settings.animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
    assign animation_classes = ' vt-animate vt-animate--' | append: block.settings.animation_type
    if block.settings.animation_type == 'slide'
      assign animation_classes = animation_classes | append: ' vt-animate--dir-from-bottom'
    endif
  endunless
-%}

<div
  id="{{ anchor }}"
  class="vt-faq-topic"
  data-faq-topic
  style="--vt-faq-topic-gap: {% render 'fluid-clamp', min_px: block.settings.gap_mobile, max_px: block.settings.gap_desktop %};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.menu_icon != 'none' -%}
    <template data-faq-topic-icon>{% render 'icons', icon: block.settings.menu_icon %}</template>
  {%- endif -%}
  {%- if title != blank -%}
    <{{ block.settings.heading_tag }}
      class="vt-faq-topic__title vt-heading {{ block.settings.heading_size }}{{ animation_classes }}"
      tabindex="-1"
      data-faq-topic-title
    >
      {{- title | escape -}}
    </{{ block.settings.heading_tag }}>
  {%- endif -%}
  <div class="vt-faq-topic__content{{ animation_classes }}" style="--vt-delay: 0.15s;">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-faq-topic {
    display: flex;
    flex-direction: column;
    gap: var(--vt-faq-topic-gap);
    width: 100%;
    /* A link to the topic leaves its heading clear of the sticky header */
    scroll-margin-block-start: calc(var(--vt-header-height, 0px) + 2rem);
  }

  .vt-faq-topic__title {
    margin: 0;
  }

  /* Focus moves here from the topic menu, so reading continues from the topic.
     The heading is not a control, so it shows no focus ring */
  .vt-faq-topic__title:focus {
    outline: none;
  }

  .vt-faq-topic__content {
    display: flex;
    flex-direction: column;
    gap: var(--vt-faq-topic-gap);
  }
{% endstylesheet %}

