{% doc %}
  A single text link: contact details (mailto:, tel:), "Read more" links, legal
  links and so on. An Icons block added inside it sits in the link, before or
  after the label, so the icon is part of the tap target and the hover state.

  Text style reuses the theme's paragraph and heading styles. The hover effect
  comes from Theme settings > Typography > Link hover effect (.vt-link and
  .vt-link-label in assets/theme.css), like the menus; Hover effect: Color only
  overrides it for this link. With Underline set to Always and the Sliding
  underline effect, the underline is drawn again on hover.

  Without a link it renders as plain text, so contact details that aren't links
  (an address, opening hours) can share the same look.

  Uppercase and the scroll-in animation work like the Heading block's.

  Self-contained: callers must leave the body empty.

  @example
  {% content_for 'block', type: 'text-link', id: 'text-link' %}
{% enddoc %}

{%- liquid
  assign link_class = 'vt-text-link inline-flex items-center ' | append: block.settings.text_style
  if block.settings.underline == 'always'
    assign link_class = link_class | append: ' vt-text-link--underline'
  endif
  if block.settings.hover_effect == 'color'
    assign link_class = link_class | append: ' vt-link--color-only'
  endif
  if block.settings.icon_position == 'end'
    assign link_class = link_class | append: ' vt-text-link--icon-end'
  endif
  if block.settings.uppercase
    assign link_class = link_class | append: ' uppercase!'
  endif

  # Scroll-in animation: the theme-wide options from snippets/animate.liquid
  # (Theme settings > Animations), off in the first section and in preview thumbnails
  assign animation_type = block.settings.animation_type
  assign animation_style = ''
  unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
    assign link_class = link_class | append: ' vt-animate vt-animate--' | append: animation_type
    if animation_type == 'slide' or animation_type == 'reveal'
      assign link_class = link_class | append: ' vt-animate--dir-' | append: block.settings.animation_direction
    endif
    assign animation_style = ' --vt-duration: ' | append: block.settings.animation_duration | append: 's; --vt-delay: ' | append: block.settings.animation_delay | append: 's;'

    if animation_type == 'slide' or animation_type == 'reveal' or animation_type == 'blur'
      case block.settings.animation_easing
        when 'linear'
          assign easing = 'linear'
        when 'ease-in-sine'
          assign easing = 'cubic-bezier(0.12, 0, 0.39, 0)'
        when 'ease-in-out-sine'
          assign easing = 'cubic-bezier(0.37, 0, 0.63, 1)'
        when 'ease-in-cubic'
          assign easing = 'cubic-bezier(0.32, 0, 0.67, 0)'
        when 'ease-out-cubic'
          assign easing = 'cubic-bezier(0.33, 1, 0.68, 1)'
        when 'ease-in-out-cubic'
          assign easing = 'cubic-bezier(0.65, 0, 0.35, 1)'
        else
          assign easing = 'cubic-bezier(0.61, 1, 0.88, 1)'
      endcase
      assign animation_style = animation_style | append: ' --vt-easing: ' | append: easing | append: ';'
    endif
    if animation_type == 'blur'
      assign animation_style = animation_style | append: ' --vt-blur: ' | append: block.settings.animation_blur_intensity | append: 'px;'
    endif
  endunless

  assign link_style = ''
  if block.settings.text_color != blank
    assign link_style = link_style | append: 'color: ' | append: block.settings.text_color | append: ';'
  endif
  if block.settings.hover_color != blank
    assign link_style = link_style | append: ' --vt-link-hover-color: ' | append: block.settings.hover_color | append: ';'
  endif
-%}

{%- liquid
  # A link renders as <a>; without one it is plain text in a <div> (a <div>, not a
  # <span>, because an Icons block inside it is a <div>)
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
    assign link_class = link_class | append: ' vt-link'
  endif
-%}

{%- if block.settings.label != blank -%}
  <{{ tag }}
    class="{{ link_class }}"
    {% if tag == 'a' %}
      href="{{ block.settings.link }}"
      {% if block.settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    {% endif %}
    style="--vt-text-link-gap: {% render 'fluid-clamp', min_px: block.settings.icon_gap_mobile, max_px: block.settings.icon_gap_desktop %};{{ link_style }}{{ animation_style }}"
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
    <span class="vt-link-label">{{ block.settings.label | escape }}</span>
    {%- if tag == 'a' and block.settings.open_in_new_tab -%}
      <span class="vt-visually-hidden">{{ 'accessibility.new_window' | t }}</span>
    {%- endif -%}
  </{{ tag }}>
{%- endif -%}

{% stylesheet %}
  .vt-text-link {
    gap: var(--vt-text-link-gap, 0.5em);
    color: inherit;
    text-decoration: none;
  }

  /* Icons block inside: decorative, sized from its own settings */
  .vt-text-link > .vt-icon {
    flex-shrink: 0;
  }

  .vt-text-link--icon-end .vt-link-label {
    order: -1;
  }

  /* Always underlined: a text underline at rest */
  .vt-text-link--underline .vt-link-label {
    text-decoration: underline;
    text-decoration-thickness: var(--vt-link-underline-thickness, 1px);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--vt-link-transition, 0.25s ease-out);
  }

  /* With the Sliding underline effect, the rest underline steps aside on hover
     and the sliding one draws it again; the other effects play on top of it */
  .vt-link-hover--underline .vt-text-link--underline.vt-link:not(.vt-link--color-only):is(:hover, :focus-visible) .vt-link-label {
    text-decoration-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-text-link--underline .vt-link-label {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text link",
  "tag": null,
  "blocks": [
    {
      "type": "icons"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Text link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to show plain text. For an email or phone number, use mailto: or tel: before it."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        {
          "value": "start",
          "label": "Before label"
        },
        {
          "value": "end",
          "label": "After label"
        }
      ],
      "default": "start",
      "info": "Add an Icon block to this link to show an icon."
    },
    {
      "type": "range",
      "id": "icon_gap_desktop",
      "label": "Gap (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "info": "Space between the icon and the label."
    },
    {
      "type": "range",
      "id": "icon_gap_mobile",
      "label": "Gap (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Link size",
      "options": [
        {
          "value": "vt-paragraph-extra-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__1.label"
        },
        {
          "value": "vt-paragraph-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label"
        },
        {
          "value": "vt-paragraph-medium",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label"
        },
        {
          "value": "vt-paragraph-large",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label"
        },
        {
          "value": "vt-heading-h1",
          "label": "t:blocks.heading.settings.heading_size.options__2.label"
        },
        {
          "value": "vt-heading-h2",
          "label": "t:blocks.heading.settings.heading_size.options__3.label"
        },
        {
          "value": "vt-heading-h3",
          "label": "t:blocks.heading.settings.heading_size.options__4.label"
        },
        {
          "value": "vt-heading-h4",
          "label": "t:blocks.heading.settings.heading_size.options__5.label"
        },
        {
          "value": "vt-heading-h5",
          "label": "t:blocks.heading.settings.heading_size.options__6.label"
        },
        {
          "value": "vt-heading-h6",
          "label": "t:blocks.heading.settings.heading_size.options__7.label"
        }
      ],
      "default": "vt-paragraph-medium"
    },
    {
      "type": "select",
      "id": "underline",
      "label": "Underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ],
      "default": "none",
      "info": "Default hover follows Link hover effect in [Theme settings > Typography](/editor?context=theme&category=typography)."
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": false,
      "info": "Overrides the text case set for this text size in [Theme settings > Typography](/editor?context=theme&category=typography)."
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover effect",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "color",
          "label": "Color only"
        }
      ],
      "default": "color",
      "info": "Color only changes the text and icon color, without a line."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "info": "Leave empty to use the text color around it."
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover color",
      "info": "With Default, colors the hover line. With Color only, colors the text and icon. Leave empty for the text color, or a lighter text color with Color only."
    },
    {
      "type": "header",
      "content": "t:blocks.heading.settings.header_animation.content"
    },
    {
      "type": "select",
      "id": "animation_type",
      "info": "Turned off in the first section of a page, so it loads faster.",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.heading.settings.animation_type.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:blocks.heading.settings.animation_type.options__2.label"
        },
        {
          "value": "slide",
          "label": "t:blocks.heading.settings.animation_type.options__3.label"
        },
        {
          "value": "reveal",
          "label": "t:blocks.heading.settings.animation_type.options__4.label"
        },
        {
          "value": "blur",
          "label": "t:blocks.heading.settings.animation_type.options__5.label"
        }
      ],
      "default": "none",
      "label": "t:blocks.heading.settings.animation_type.label"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "options": [
        {
          "value": "from-left",
          "label": "t:blocks.heading.settings.animation_direction.options__1.label"
        },
        {
          "value": "from-right",
          "label": "t:blocks.heading.settings.animation_direction.options__2.label"
        },
        {
          "value": "from-top",
          "label": "t:blocks.heading.settings.animation_direction.options__3.label"
        },
        {
          "value": "from-bottom",
          "label": "t:blocks.heading.settings.animation_direction.options__4.label"
        }
      ],
      "default": "from-bottom",
      "label": "t:blocks.heading.settings.animation_direction.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' }}"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "unit": "s",
      "default": 1.2,
      "label": "t:blocks.heading.settings.animation_duration.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "default": 0.2,
      "label": "t:blocks.heading.settings.animation_delay.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "options": [
        {
          "value": "linear",
          "label": "t:blocks.heading.settings.animation_easing.options__1.label"
        },
        {
          "value": "ease-out-sine",
          "label": "t:blocks.heading.settings.animation_easing.options__2.label"
        },
        {
          "value": "ease-in-sine",
          "label": "t:blocks.heading.settings.animation_easing.options__3.label"
        },
        {
          "value": "ease-in-out-sine",
          "label": "t:blocks.heading.settings.animation_easing.options__4.label"
        },
        {
          "value": "ease-in-cubic",
          "label": "t:blocks.heading.settings.animation_easing.options__5.label"
        },
        {
          "value": "ease-out-cubic",
          "label": "t:blocks.heading.settings.animation_easing.options__6.label"
        },
        {
          "value": "ease-in-out-cubic",
          "label": "t:blocks.heading.settings.animation_easing.options__7.label"
        }
      ],
      "default": "ease-out-sine",
      "label": "t:blocks.heading.settings.animation_easing.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' or block.settings.animation_type == 'blur' }}"
    },
    {
      "type": "range",
      "id": "animation_blur_intensity",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 5,
      "label": "t:blocks.heading.settings.animation_blur_intensity.label",
      "visible_if": "{{ block.settings.animation_type == 'blur' }}"
    }
  ],
  "presets": [
    {
      "name": "Text link"
    }
  ]
}
{% endschema %}
