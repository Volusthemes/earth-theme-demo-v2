{% doc %}
  Renders a scroll highlight text block with progressive word reveal and smooth gradient falloff trail.
  Uses a visually-hidden span for screen reader accessibility and SEO, while rendering
  clipped word spans for the visual animation.

  @example
  {% content_for 'block', type: 'scroll-highlight-text', id: 'scroll-highlight' %}
{% enddoc %}

{%- assign raw_text = block.settings.heading | default: block.settings.text -%}
{%- if raw_text != blank -%}
  {%- liquid
    assign words = raw_text | strip_html | strip | replace: "\r\n", ' ' | replace: "\n", ' ' | split: ' '

    assign active_color = 'inherit'
    if block.settings.text_color != blank and block.settings.text_color.alpha != 0
      assign active_color = block.settings.text_color
    endif

    assign start_opacity = block.settings.start_opacity | default: 30 | times: 1.0 | divided_by: 100.0

    # In visual preview mode, illuminate 60% of words so merchant previews the highlight effect
    assign preview_count = 0
    if request.visual_preview_mode
      assign preview_count = words.size | times: 6 | divided_by: 10
    endif

    assign animation_type = block.settings.animation_type

    assign vt_anim_classes = ''
    unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
      assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type
      if animation_type == 'slide' or animation_type == 'reveal'
        assign vt_anim_classes = vt_anim_classes | append: ' vt-animate--dir-' | append: block.settings.animation_direction
      endif
    endunless

    assign heading_class = 'vt-heading ' | append: block.settings.heading_size
    if block.settings.uppercase
      assign heading_class = heading_class | append: ' uppercase!'
    endif
    if vt_anim_classes != blank
      assign heading_class = heading_class | append: ' ' | append: vt_anim_classes
    endif

    assign vt_style = ''
    unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
      assign vt_style = vt_style | append: '--vt-duration: ' | append: block.settings.animation_duration | append: 's;'
      assign vt_style = vt_style | append: ' --vt-delay: ' | append: block.settings.animation_delay | append: 's;'

      if animation_type == 'slide' or animation_type == 'reveal' or animation_type == 'blur'
        case block.settings.animation_easing
          when 'linear'
            assign vt_easing_value = 'linear'
          when 'ease-out-sine'
            assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
          when 'ease-in-sine'
            assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)'
          when 'ease-in-out-sine'
            assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)'
          when 'ease-in-cubic'
            assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)'
          when 'ease-out-cubic'
            assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)'
          when 'ease-in-out-cubic'
            assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)'
          else
            assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
        endcase
        assign vt_style = vt_style | append: ' --vt-easing: ' | append: vt_easing_value | append: ';'
      endif

      if animation_type == 'blur'
        assign vt_style = vt_style | append: ' --vt-blur: ' | append: block.settings.animation_blur_intensity | append: 'px;'
      endif
    endunless

    assign vt_wrapper_class = 'vt-heading-wrapper ' | append: block.settings.heading_alignment | append: ' vt-heading-wrapper--width-' | append: block.settings.heading_width
  -%}

  <vt-scroll-highlight-text
    class="{{ heading_class }} {{ vt_wrapper_class }} vt-scroll-highlight-text"
    style="
      --vt-sh-active-color: {{ active_color }};
      --vt-sh-start-opacity: {{ start_opacity }};
      --start-opacity: {{ start_opacity }};
      {%- if block.settings.heading_width == 'custom' %}--vt-heading-width: {{ block.settings.width_custom }}%;{% endif -%}
      {%- if block.settings.enable_max_width %}--vt-heading-max-width: {% render 'fluid-clamp', min_px: block.settings.heading_max_width, max_px: block.settings.heading_max_width %};{% endif -%}
      {%- if vt_style != blank %}{{ vt_style | strip }}{% endif -%}
    "
    data-band-start="0.85"
    data-band-end="0.15"
    data-speed="1.0"
    data-start-opacity="{{ start_opacity }}"
    {{ block.shopify_attributes }}
  >
    <span class="vt-visually-hidden">
      {{- raw_text | strip_html -}}
    </span>

    {%- for word in words -%}
      {%- if word != blank -%}
        <span class="vt-scroll-highlight__word-clip" aria-hidden="true">
          <span
            class="vt-scroll-highlight__word{% if request.visual_preview_mode and forloop.index <= preview_count %} is-active{% endif %}"
          >
            {{- word -}}
          </span>
        </span>
        {%- unless forloop.last -%}
          {{ ' ' }}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </vt-scroll-highlight-text>

  <script src="{{ 'theme-scroll-highlight.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  vt-scroll-highlight-text.vt-scroll-highlight-text,
  .vt-scroll-highlight-text {
    display: block;
    width: 100%;
    max-width: var(--vt-heading-max-width, 100%);
    box-sizing: border-box;
    white-space: normal;
    word-break: normal;
    overflow-wrap: break-word;
    color: var(--vt-sh-active-color, inherit);
    margin: 0;
    position: relative;
  }

  .vt-scroll-highlight-text.text-left {
    text-align: left;
    margin-inline-end: auto;
    margin-inline-start: 0;
  }

  .vt-scroll-highlight-text.text-center {
    text-align: center;
    margin-inline: auto;
  }

  .vt-scroll-highlight-text.text-right {
    text-align: right;
    margin-inline-start: auto;
    margin-inline-end: 0;
  }

  .vt-scroll-highlight-text.text-inherit {
    text-align: inherit;
  }

  .vt-scroll-highlight-text.vt-heading-wrapper--width-fit {
    width: fit-content;
    max-width: 100%;
  }

  .vt-scroll-highlight-text.vt-heading-wrapper--width-fill {
    width: 100%;
  }

  .vt-scroll-highlight-text.vt-heading-wrapper--width-custom {
    width: var(--vt-heading-width, 100%);
    max-width: 100%;
  }

  .vt-scroll-highlight-text.vt-heading-wrapper--width-max-content {
    width: max-content;
    max-width: 100%;
  }

  .vt-scroll-highlight-text.vt-heading-wrapper--width-min-content {
    width: min-content;
  }

  .vt-scroll-highlight__word-clip {
    display: inline-block;
    vertical-align: top;
  }

  .vt-scroll-highlight__word {
    display: inline-block;
    color: inherit;
    opacity: var(--vt-sh-start-opacity, 0.3);
    transition: opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: opacity;
  }

  .vt-scroll-highlight__word.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-scroll-highlight__word {
      transition: none;
      opacity: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scroll highlight text",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Good streetwear doesn't need hype. It needs to show up every day and still be worth reaching for.",
      "label": "t:blocks.heading.settings.heading.label"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "text-left", "label": "t:blocks.heading.settings.heading_alignment.options__1.label" },
        { "value": "text-center", "label": "t:blocks.heading.settings.heading_alignment.options__2.label" },
        { "value": "text-right", "label": "t:blocks.heading.settings.heading_alignment.options__3.label" },
        { "value": "text-inherit", "label": "Inherit" }
      ],
      "default": "text-inherit",
      "label": "t:blocks.heading.settings.heading_alignment.label"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "vt-hero-heading", "label": "t:blocks.heading.settings.heading_size.options__1.label" },
        { "value": "vt-heading-h1", "label": "t:blocks.heading.settings.heading_size.options__2.label" },
        { "value": "vt-heading-h2", "label": "t:blocks.heading.settings.heading_size.options__3.label" },
        { "value": "vt-heading-h3", "label": "t:blocks.heading.settings.heading_size.options__4.label" },
        { "value": "vt-heading-h4", "label": "t:blocks.heading.settings.heading_size.options__5.label" },
        { "value": "vt-heading-h5", "label": "t:blocks.heading.settings.heading_size.options__6.label" },
        { "value": "vt-heading-h6", "label": "t:blocks.heading.settings.heading_size.options__7.label" }
      ],
      "default": "vt-hero-heading",
      "label": "t:blocks.heading.settings.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": true,
      "info": "Overrides the text case set for this heading size in [Theme settings > Typography](/editor?context=theme&category=typography)."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to follow the section or color palette."
    },
    {
      "type": "range",
      "id": "start_opacity",
      "label": "Start opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "select",
      "id": "heading_width",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "max-content", "label": "Max content" },
        { "value": "min-content", "label": "Min content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "Custom width",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.heading_width == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_max_width",
      "label": "Width limit",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 100,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 600,
      "label": "Max width",
      "visible_if": "{{ block.settings.enable_max_width == true }}"
    },
    {
      "type": "header",
      "content": "t:blocks.heading.settings.header_animation.content"
    },
    {
      "type": "select",
      "id": "animation_type",
      "info": "Turned off in the first section of a page, so it loads faster.",
      "options": [
        { "value": "none", "label": "t:blocks.heading.settings.animation_type.options__1.label" },
        { "value": "fade", "label": "t:blocks.heading.settings.animation_type.options__2.label" },
        { "value": "slide", "label": "t:blocks.heading.settings.animation_type.options__3.label" },
        { "value": "reveal", "label": "t:blocks.heading.settings.animation_type.options__4.label" },
        { "value": "blur", "label": "t:blocks.heading.settings.animation_type.options__5.label" }
      ],
      "default": "none",
      "label": "t:blocks.heading.settings.animation_type.label"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "options": [
        { "value": "from-left", "label": "t:blocks.heading.settings.animation_direction.options__1.label" },
        { "value": "from-right", "label": "t:blocks.heading.settings.animation_direction.options__2.label" },
        { "value": "from-top", "label": "t:blocks.heading.settings.animation_direction.options__3.label" },
        { "value": "from-bottom", "label": "t:blocks.heading.settings.animation_direction.options__4.label" }
      ],
      "default": "from-bottom",
      "label": "t:blocks.heading.settings.animation_direction.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' }}"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "unit": "s",
      "default": 1.2,
      "label": "t:blocks.heading.settings.animation_duration.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "default": 0.2,
      "label": "t:blocks.heading.settings.animation_delay.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "options": [
        { "value": "linear", "label": "t:blocks.heading.settings.animation_easing.options__1.label" },
        { "value": "ease-out-sine", "label": "t:blocks.heading.settings.animation_easing.options__2.label" },
        { "value": "ease-in-sine", "label": "t:blocks.heading.settings.animation_easing.options__3.label" },
        { "value": "ease-in-out-sine", "label": "t:blocks.heading.settings.animation_easing.options__4.label" },
        { "value": "ease-in-cubic", "label": "t:blocks.heading.settings.animation_easing.options__5.label" },
        { "value": "ease-out-cubic", "label": "t:blocks.heading.settings.animation_easing.options__6.label" },
        { "value": "ease-in-out-cubic", "label": "t:blocks.heading.settings.animation_easing.options__7.label" }
      ],
      "default": "ease-out-sine",
      "label": "t:blocks.heading.settings.animation_easing.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' or block.settings.animation_type == 'blur' }}"
    },
    {
      "type": "range",
      "id": "animation_blur_intensity",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 5,
      "label": "t:blocks.heading.settings.animation_blur_intensity.label",
      "visible_if": "{{ block.settings.animation_type == 'blur' }}"
    }
  ],
  "presets": [
    {
      "name": "Scroll highlight text",
      "category": "t:general.categories.basic",
      "settings": {
        "heading": "Good streetwear doesn't need hype. It needs to show up every day and still be worth reaching for.",
        "heading_size": "vt-heading-h1",
        "heading_alignment": "text-inherit",
        "uppercase": true,
        "text_color": "",
        "start_opacity": 30,
        "heading_width": "fit",
        "animation_type": "none"
      }
    }
  ]
}
{% endschema %}
