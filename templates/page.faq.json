                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "products_q2_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Wash cold on a gentle cycle with similar colors, and dry flat or line dry. Washing less and cooler keeps fibers soft and saves energy.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
