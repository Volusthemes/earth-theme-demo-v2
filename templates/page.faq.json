                                            },
                                            "blocks": {
                                                "payment_q1": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Which payment methods do you accept?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "payment_q1_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>We accept major credit and debit cards, Shop Pay, PayPal, Apple Pay and Google Pay. Available options appear at checkout.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "payment_q1_answer"
                                                    ]
                                                },
                                                "payment_q2": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Is my payment information secure?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "payment_q2_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Yes. Payments are processed over an encrypted connection by certified payment providers. We never store your full card details.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "payment_q2_answer"
                                                    ]
                                                },
                                                "payment_q3": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Do I need an account to place an order?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "payment_q3_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>No, you can check out as a guest. An account lets you track orders, save addresses and start returns faster.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "payment_q3_answer"
