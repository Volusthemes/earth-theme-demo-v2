                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "products_q3_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Our fabrics are pre-washed to keep shrinking minimal. Avoid the tumble dryer and hot water to keep the original fit.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
