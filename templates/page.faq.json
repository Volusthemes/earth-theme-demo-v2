                                        "animation_type": "slide"
                                    },
                                    "blocks": {
                                        "returns_questions": {
                                            "type": "accordion",
                                            "name": "Questions",
                                            "settings": {
                                                "open_one_at_a_time": true,
                                                "keep_first_open": true,
                                                "expand_effect": "slide_fade",
                                                "indicator": "arrow",
                                                "indicator_size_desktop": 20,
                                                "indicator_size_mobile": 18,
                                                "gap": 16,
                                                "padding_x_desktop": 28,
                                                "padding_x_mobile": 20,
                                                "padding_y_desktop": 24,
                                                "padding_y_mobile": 20,
                                                "content_gap_desktop": 16,
                                                "content_gap_mobile": 12,
                                                "border_style": "all",
                                                "header_divider": true,
                                                "border_thickness": 1,
                                                "hover_highlight": "none",
                                                "open_highlight": "none",
                                                "animation_type": "none"
                                            },
                                            "blocks": {
                                                "returns_q1": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "What is your return policy?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "returns_q1_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>You can return unworn items with their tags within 30 days of delivery for a full refund to the original payment method.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "returns_q1_answer"
                                                    ]
                                                },
                                                "returns_q2": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "How do I start a return or exchange?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "returns_q2_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Visit our returns page, enter your order number and email, and choose the items to send back. We email you a prepaid return label.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "returns_q2_answer"
                                                    ]
                                                },
                                                "returns_q3": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "When will I receive my refund?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "returns_q3_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Refunds are issued within 5 business days of your return reaching us. Your bank may take a few more days to show it.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "returns_q3_answer"
                                                    ]
                                                },
                                                "returns_q4": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Can I exchange an item for a different size?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "returns_q4_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Yes. Choose Exchange when you start your return, and we ship the new size as soon as your return is scanned by the carrier.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "returns_q4_answer"
                                                    ]
                                                }
                                            },
                                            "block_order": [
                                                "returns_q1",
                                                "returns_q2",
                                                "returns_q3",
                                                "returns_q4"
                                            ]
                                        }
                                    },
                                    "block_order": [
                                        "returns_questions"
                                    ]
                                },
