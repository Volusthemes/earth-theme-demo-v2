                                        "gap_desktop": 32,
                                        "gap_mobile": 24,
                                        "animation_type": "slide"
                                    },
                                    "blocks": {
                                        "orders_questions": {
                                            "type": "accordion",
                                            "name": "Questions",
                                            "settings": {
                                                "open_one_at_a_time": true,
                                                "keep_first_open": true,
                                                "expand_effect": "slide_fade",
                                                "indicator": "arrow",
                                                "indicator_size_desktop": 20,
                                                "indicator_size_mobile": 18,
                                                "gap": 16,
                                                "padding_x_desktop": 28,
                                                "padding_x_mobile": 20,
                                                "padding_y_desktop": 24,
                                                "padding_y_mobile": 20,
                                                "content_gap_desktop": 16,
                                                "content_gap_mobile": 12,
                                                "border_style": "all",
                                                "header_divider": true,
                                                "border_thickness": 1,
                                                "hover_highlight": "none",
                                                "open_highlight": "none",
                                                "animation_type": "none"
                                            },
                                            "blocks": {
                                                "orders_q1": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "How do I know my order has been confirmed?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "orders_q1_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Once your order is placed, you will receive a confirmation email with your order number and purchase details. If you do not see it within a few minutes, please check your spam or promotions folder. If it is still missing, contact us with the name and email used at checkout.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "orders_q1_answer"
                                                    ]
                                                },
                                                "orders_q2": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "How can I track my order?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "orders_q2_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>As soon as your order ships, we email you a tracking link. You can also follow every step from your account under Orders.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "orders_q2_answer"
                                                    ]
                                                },
                                                "orders_q3": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Can I change or cancel my order?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "orders_q3_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>We can change or cancel an order within 2 hours of purchase, before it is packed. Contact us with your order number as soon as possible.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "orders_q3_answer"
                                                    ]
                                                },
                                                "orders_q4": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "What if my order is delayed or missing?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "orders_q4_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Most delays clear within a couple of days. If your tracking has not moved for 5 business days, or the parcel shows as delivered but did not arrive, contact us and we will trace it with the carrier.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "orders_q4_answer"
                                                    ]
                                                },
                                                "orders_q5": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "What if I received the wrong item?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "orders_q5_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>We are sorry for the mix-up. Send us a photo of the item and your order number, and we will ship the right piece and a prepaid label for the return.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "orders_q5_answer"
                                                    ]
                                                }
                                            },
                                            "block_order": [
                                                "orders_q1",
                                                "orders_q2",
                                                "orders_q3",
                                                "orders_q4",
                                                "orders_q5"
                                            ]
                                        }
                                    },
                                    "block_order": [
                                        "orders_questions"
                                    ]
                                },
                                "shipping": {
                                    "type": "faq-topic",
                                    "settings": {
                                        "title": "Shipping & Delivery",
                                        "menu_icon": "shipping-delivery",
                                        "heading_size": "vt-heading-h3",
                                        "heading_tag": "h2",
                                        "gap_desktop": 32,
                                        "gap_mobile": 24,
                                        "animation_type": "slide"
                                    },
                                    "blocks": {
                                        "shipping_questions": {
                                            "type": "accordion",
                                            "name": "Questions",
                                            "settings": {
                                                "open_one_at_a_time": true,
                                                "keep_first_open": true,
                                                "expand_effect": "slide_fade",
                                                "indicator": "arrow",
                                                "indicator_size_desktop": 20,
                                                "indicator_size_mobile": 18,
                                                "gap": 16,
                                                "padding_x_desktop": 28,
                                                "padding_x_mobile": 20,
                                                "padding_y_desktop": 24,
                                                "padding_y_mobile": 20,
                                                "content_gap_desktop": 16,
                                                "content_gap_mobile": 12,
                                                "border_style": "all",
                                                "header_divider": true,
                                                "border_thickness": 1,
                                                "hover_highlight": "none",
                                                "open_highlight": "none",
                                                "animation_type": "none"
                                            },
                                            "blocks": {
                                                "shipping_q1": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Where does Earth ship to?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "shipping_q1_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Earth currently ships to selected domestic and international destinations. Available shipping options will appear at checkout once you enter your delivery address.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "shipping_q1_answer"
                                                    ]
                                                },
                                                "shipping_q2": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "How long will delivery take?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "shipping_q2_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Domestic orders arrive in 2–5 business days. International orders usually take 7–14 business days, depending on the destination and customs.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "shipping_q2_answer"
                                                    ]
                                                },
                                                "shipping_q3": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "How much does shipping cost?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "shipping_q3_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Shipping is calculated at checkout from the weight of your order and the delivery address. Domestic orders over $100 ship free.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "shipping_q3_answer"
                                                    ]
                                                },
                                                "shipping_q4": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Do you offer international shipping?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "shipping_q4_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Yes. Duties and taxes may apply on arrival, depending on your country. They are shown at checkout where we can include them.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "shipping_q4_answer"
                                                    ]
                                                },
                                                "shipping_q5": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Can I update my shipping address after ordering?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "shipping_q5_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>If your order has not shipped yet, we can update the address. Reply to your order confirmation email with the new address.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "shipping_q5_answer"
                                                    ]
                                                },
                                                "shipping_q6": {
                                                    "type": "_accordion-item",
                                                    "settings": {
                                                        "heading": "Is Earth packaging plastic-free?",
                                                        "heading_size": "vt-heading-h5",
                                                        "heading_tag": "h3"
                                                    },
                                                    "blocks": {
                                                        "shipping_q6_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Yes. Every order ships in recycled paper mailers or boxes, sealed with paper tape, so all of it can go in your recycling bin.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
                                                                "paragraph_width": "fill",
                                                                "animation_type": "none"
                                                            }
                                                        }
                                                    },
                                                    "block_order": [
                                                        "shipping_q6_answer"
                                                    ]
                                                }
                                            },
                                            "block_order": [
                                                "shipping_q1",
                                                "shipping_q2",
                                                "shipping_q3",
                                                "shipping_q4",
                                                "shipping_q5",
                                                "shipping_q6"
                                            ]
                                        }
                                    },
                                    "block_order": [
                                        "shipping_questions"
                                    ]
                                },
                                "returns": {
                                    "type": "faq-topic",
