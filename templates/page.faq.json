                                                    "blocks": {
                                                        "products_q1_answer": {
                                                            "type": "paragraph",
                                                            "settings": {
                                                                "text": "<p>Each product page has a size guide with body and garment measurements. If you are between sizes, the product notes tell you which way to go.</p>",
                                                                "paragraph_size": "vt-paragraph-medium",
                                                                "paragraph_alignment": "text-left",
