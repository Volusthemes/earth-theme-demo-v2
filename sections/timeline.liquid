{%- comment -%}
  Section: Timeline
  - Left: intro stack, badge list and closing stack (always last). On desktop the
    three stay in view (sticky) while the cards scroll past.
  - Right: one Timeline item per milestone. Each item is a card that takes any
    theme block (image, sub-heading, heading, paragraph...).
  - assets/theme-timeline.js builds the badge list from the cards (their "Badge label",
    or their heading), so it never goes out of sync, and highlights the badge of the
    card in view. Liquid can't read theme block settings from section.blocks, so the
    list can't be built here.
  - Card entrance uses the theme's scroll animations (snippets/animate.liquid), started
    when a card reaches the middle of the screen, so cards appear one at a time.
  - Below 990px: intro, cards, then the closing stack; the badge list is hidden.
{%- endcomment -%}

{%- liquid
  assign inner_classes = 'vt-section__inner'
  if section.settings.make_section_page_width
    assign inner_classes = inner_classes | append: ' vt-page-width'
  endif

  # Only Timeline items can be added, and static blocks aren't in section.blocks
  assign items = section.blocks

  assign timeline_classes = 'vt-timeline'
  if section.settings.sticky_content
    assign timeline_classes = timeline_classes | append: ' vt-timeline--sticky'
  endif

  # Empty card colors follow the color palette
  assign card_bg = section.settings.card_background | default: 'var(--vt-background-color)'
  assign card_heading = section.settings.card_text_color | default: 'var(--vt-foreground-color)'
  assign card_paragraph = section.settings.card_text_color | default: 'var(--vt-color-primary)'
-%}

{% render 'section-styles', section: section %}

<div class="vt-section vt-timeline-section" {{ section.shopify_attributes }}>
  <div class="{{ inner_classes }}">
    <vt-timeline
      class="{{ timeline_classes }}"
      style="
        --vt-timeline-content-width: {{ section.settings.content_width }}%;
        --vt-timeline-column-gap: {{ section.settings.column_gap | divided_by: 16.0 }}rem;
        --vt-timeline-sticky-top: {{ section.settings.sticky_offset | divided_by: 16.0 }}rem;
        --vt-timeline-card-spacing: {% render 'fluid-clamp', min_px: section.settings.card_spacing_mobile, max_px: section.settings.card_spacing %};
        --vt-timeline-card-bg: {{ card_bg }};
        --vt-timeline-card-heading: {{ card_heading }};
        --vt-timeline-card-paragraph: {{ card_paragraph }};
        --vt-timeline-card-padding: {% render 'fluid-clamp', min_px: section.settings.card_padding_mobile, max_px: section.settings.card_padding %};
        --vt-timeline-card-gap: {% render 'fluid-clamp', min_px: section.settings.card_gap_mobile, max_px: section.settings.card_gap %};
        --vt-timeline-card-radius: {{ section.settings.card_radius | divided_by: 16.0 }}rem;
      "
    >
      <div class="vt-timeline__aside">
        <div class="vt-timeline__intro">
          {% content_for 'block', type: 'stack', id: 'timeline-intro' %}
        </div>

        {% content_for 'block', type: '_timeline-badges', id: 'timeline-badges' %}

        <div class="vt-timeline__closing">
          {% content_for 'block', type: 'stack', id: 'timeline-closing' %}
        </div>
      </div>

      {%- if items.size > 0 or request.design_mode -%}
        <ol class="vt-timeline__items" role="list">
          {% content_for 'blocks' %}
        </ol>
      {%- endif -%}
    </vt-timeline>
  </div>
</div>

{%- if items.size > 0 -%}
  <script src="{{ 'theme-timeline.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  /* ---- Layout: mobile first (one column: intro, cards, closing) ---- */
  .vt-timeline {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--vt-section-gap, 2.5rem);
  }

  /* The aside's parts join the grid directly, so the closing stack can move after the cards */
  .vt-timeline__aside {
    display: contents;
  }

  .vt-timeline__intro {
    order: 1;
  }

  .vt-timeline__items {
    order: 2;
    display: flex;
    flex-direction: column;
    gap: var(--vt-timeline-card-spacing);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vt-timeline__closing {
    order: 3;
  }

  /* Empty static stacks take no room */
  .vt-timeline__intro:not(:has(> .vt-stack > *)),
  .vt-timeline__closing:not(:has(> .vt-stack > *)) {
    display: none;
  }

  /* ---- Desktop: two columns, content on the left ---- */
  @media screen and (min-width: 990px) {
    .vt-timeline {
      grid-template-columns:
        minmax(0, calc(var(--vt-timeline-content-width) - var(--vt-timeline-column-gap) / 2))
        minmax(0, 1fr);
      column-gap: var(--vt-timeline-column-gap);
      align-items: start;
    }

    .vt-timeline__aside {
      display: flex;
      flex-direction: column;
      gap: var(--vt-section-gap, 2.5rem);
    }

    /* Back to source order inside the column: intro, badges, closing */
    .vt-timeline__aside > * {
      order: 0;
    }

    /* Sticky: the column fills the screen, so the closing stack rests at its bottom edge */
    .vt-timeline--sticky .vt-timeline__aside {
      position: sticky;
      top: var(--vt-timeline-sticky-top);
      min-height: calc(100svh - var(--vt-timeline-sticky-top) * 2);
    }

    .vt-timeline__closing {
      margin-block-start: auto;
    }
  }

  /* ---- Cards ---- */
  .vt-timeline-item {
    display: flex;
    flex-direction: column;
    gap: var(--vt-timeline-card-gap);
    padding: var(--vt-timeline-card-padding);
    border-radius: var(--vt-timeline-card-radius);
    background: var(--vt-timeline-card-bg);
    color: var(--vt-timeline-card-heading);
    --vt-section-paragraph-color: var(--vt-timeline-card-paragraph);
    /* A badge jump leaves the card clear of the sticky header */
    scroll-margin-block-start: calc(var(--vt-timeline-sticky-top) + 1rem);
  }

  .vt-timeline-item:focus {
    outline: none;
  }

  .vt-timeline-item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* Card entrance (classes from the item block): a short, soft settle, one card at a time */
  .vt-timeline-item.vt-animate {
    --vt-duration: 0.8s;
    --vt-easing: cubic-bezier(0.22, 1, 0.36, 1);
    --vt-offset: 1.5rem;
  }
{% endstylesheet %}

